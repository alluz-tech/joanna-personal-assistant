# Código numérico da tela de acesso (uso pessoal). Padrão: 278395.
JOANNA_PIN=278395
OPENAI_API_KEY=your_openai_api_key
# Example: gpt-4.1-mini. Choose a model available to your OpenAI account.
OPENAI_MODEL=gpt-4.1-mini
# Conversa por voz (opcional): modelos de transcrição e de fala e a voz usada.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=shimmer
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5089/auth/google/callback
CALENDAR_TIMEZONE=America/Sao_Paulo
TOKEN_PATH=data/token.json
